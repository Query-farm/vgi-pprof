# name: test/sql/blob_overload.test
# group: [vgi_pprof]
#
# The BLOB arg-overload: a profile passed as inline bytes decodes the same as a
# path (here a base64 literal of data/go_cpu.pb.gz, so the test needs no fixture
# file).

require-env VGI_PPROF_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'pprof' AS pprof (TYPE vgi, LOCATION '${VGI_PPROF_WORKER}');

statement ok
SET search_path = 'pprof.main';

# BLOB overload: the Go CPU profile passed as inline bytes yields the same two
# samples as the path form; `file` is NULL for BLOB input.
query II
SELECT count(*), count(*) FILTER (WHERE file IS NULL)
FROM stacks(from_base64(''))
WHERE error IS NULL;
----
2	2

# The headline rollup works identically on inline bytes.
query TI
SELECT s.frame[1].function AS fn, sum(s.value[2]) AS cpu_ns
FROM stacks(from_base64('')) s
WHERE s.error IS NULL GROUP BY 1 ORDER BY 2 DESC;
----
main.hotLoop	30000000
main.parse	5000000
